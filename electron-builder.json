{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.melo.desktop",
  "productName": "MELO",
  "directories": {
    "output": "releases"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/**/*",
    "sql-wasm.wasm",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.wasm"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "MELO-Setup.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MELO"
  }
}
